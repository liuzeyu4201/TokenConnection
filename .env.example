# ---- Postgres (docker compose) ----
POSTGRES_PASSWORD=tokenconnection
# Host port mapped to the container's 5432. 5432 itself is often taken by another local Postgres.
POSTGRES_PORT=5433
DATABASE_URL=postgres://postgres:tokenconnection@localhost:5433/tokenconnection

# ---- API auth (design.md §8) ----
# Every /api/v1/* request must carry `Authorization: Bearer <API_TOKEN>`.
# The web UI receives the same token as a same-site cookie automatically.
API_TOKEN=change-me-to-a-long-random-string

# ---- LLM (design.md §13) ----
# mock: no network, heuristic extraction + deterministic pseudo embeddings (default for dev/seed/test)
# real: DeepSeek for extraction + an OpenAI-compatible embeddings endpoint; requires the keys below
LLM_PROVIDER=mock

# Extraction / intent detection. `deepseek-chat` works as of 2026-09; if it is ever
# retired, switch to `deepseek-flash` (fast) or `deepseek-v4-pro` (slow, stronger).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Embeddings: any OpenAI-compatible /embeddings endpoint. Default is SiliconFlow (硅基流动)
# serving Qwen3-Embedding-4B. The app requests `dimensions=EMBEDDING_DIM`, so the model
# must support Matryoshka truncation (all Qwen3-Embedding sizes do; Qwen3-VL-Embedding-8B
# also does, but scored near random on our person text — avoid it).
# EMBEDDING_DIM must stay 1024 (matches the people_embeddings.embedding column);
# changing the model requires `pnpm db:reembed`.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_DIM=1024

# Image reading (cards, chat screenshots). Uses the embedding key and base URL
# unless overridden. DeepSeek chat cannot take images.
# VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
# VISION_API_KEY=
# VISION_BASE_URL=
